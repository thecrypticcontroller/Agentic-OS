# ── Search providers (at least one recommended for web search jobs) ──────────
# Brave Search — 2,000 free queries/month: https://api.search.brave.com/register
BRAVE_API_KEY=

# Tavily — 1,000 free queries/month: https://app.tavily.com
TAVILY_API_KEY=

# Exa — 1,000 free queries/month: https://dashboard.exa.ai
EXA_API_KEY=

# ── LLM synthesis (optional) ─────────────────────────────────────────────────
# Gemini — free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
AGENT_OS_LLM_ENABLED=false

# ── Reserve scraping provider ─────────────────────────────────────────────────
# Firecrawl — only used when allow_reserve=True: https://firecrawl.dev
FIRECRAWL_API_KEY=

# ── Feature flags ─────────────────────────────────────────────────────────────
# Deprioritise failing providers automatically
AGENT_OS_ADAPTIVE_ROUTING=false

# ── Browser worker (optional) ─────────────────────────────────────────────────
BU_CDP_URL=http://127.0.0.1:9222
BH_HOME=./browsers/harness
